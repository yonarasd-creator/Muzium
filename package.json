{
  "name": "muzigim",
  "version": "2.8.2",
  "description": "Kişiselleştirilebilir müzik çalar: hesaplar, profiller, arkadaşlar, mesajlaşma, şarkı paylaşımı, özel temalar",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node test/test.js",
    "test:ui": "node test/ui.test.js",
    "app": "electron electron/main.js",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "fake-indexeddb": "^6.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.muzigim.app",
    "productName": "Yoni",
    "publish": {
      "provider": "github",
      "releaseType": "release",
      "owner": "yonarasd-creator",
      "repo": "Muzium"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "electron/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "artifactName": "Yoni-Kurulum-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  }
}